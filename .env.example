# Token du bot Discord (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Clé API LeBonDeal (lbd_live_xxxxxxxx...)
LEBONDEAL_API_KEY=

# Ne pas modifier sauf si l'URL de l'API change
API_BASE_URL=https://bot.lebondeal-bot.fr

# Chemin de la base SQLite (laisser tel quel sur Pterodactyl)
DB_PATH=data/bot.db

# Facultatif: IDs Discord (séparés par des virgules) des propriétaires du bot
OWNER_IDS=

# Facultatif: ID de serveur pour une synchronisation instantanée des commandes slash pendant les tests
GUILD_ID=
